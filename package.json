{
  "name": "spice-schematic-preview",
  "version": "0.2.0",
  "private": true,
  "description": "Obsidian plugin: draw SPICE netlists in spice code blocks as circuit schematics.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup.ts --test test/*.test.ts",
    "test:live": "node scripts/test-live.mjs",
    "vault": "node scripts/dev-vault.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@reonarudo/spice-renderer": "https://github.com/Reonarudo/spice-renderer/releases/download/v1.1.0/reonarudo-spice-renderer-1.1.0.tgz",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "obsidian": "1.14.4",
    "playwright-core": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
